# Optional environment variables (copy to .env; never commit secrets).
# Point to a paths YAML outside the repo instead of configs/paths.yaml:
EOB_PATHS=/absolute/path/to/paths.yaml
# Select the physical GPU; the code then addresses it as cuda:0.
CUDA_VISIBLE_DEVICES=1
# Inference never downloads; these are also set by the backend.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# Hugging Face authentication is done with `hf auth login` (stored by the hf CLI), not in this file.
